<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/home_padding">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_title_top"
            android:layout_marginBottom="@dimen/home_title_bottom"
            android:text="@string/title"
            android:textSize="@dimen/home_title_size"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurface"
            android:accessibilityHeading="true" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/client_card_padding">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/default_client"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnPrimaryContainer" />
                <TextView
                    android:id="@+id/selected_client"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/no_client"
                    android:textSize="@dimen/client_name_size"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnPrimaryContainer" />
                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/client_hint"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:accessibilityLiveRegion="polite" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/client_actions_top"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/choose_client"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/client_action_height"
                        android:layout_marginEnd="8dp"
                        android:text="@string/choose_client"
                        app:cornerRadius="24dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/open_client"
                        style="@style/Widget.Material3Expressive.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/client_action_height"
                        android:text="@string/open_client"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/link_title"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:accessibilityHeading="true" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/paste_link"
                        style="@style/Widget.Material3Expressive.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/paste" />
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/link_field"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/link_hint"
                    app:boxCornerRadiusTopStart="20dp"
                    app:boxCornerRadiusTopEnd="20dp"
                    app:boxCornerRadiusBottomStart="20dp"
                    app:boxCornerRadiusBottomEnd="20dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/link_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="@integer/link_visible_lines"
                        android:maxLines="@integer/link_visible_lines"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:padding="@dimen/link_input_padding"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="@dimen/open_link_height"
                    android:text="@string/open_link"
                    android:textSize="16sp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_arrow"
                    app:iconGravity="textEnd" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/link_settings"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginEnd="12dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/link_settings"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="20dp"
                    app:iconPadding="8dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="20dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/help"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/help"
                    app:icon="@drawable/ic_help"
                    app:iconSize="20dp"
                    app:iconPadding="8dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="20dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
